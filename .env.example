# Required server database configuration (run the SQL migration before deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Required: at least 32 cryptographically random characters. Never use an example key.
# Changing this invalidates existing sessions and pending upload tickets.
SESSION_SECRET=

# Optional push feature: generate a unique pair with npm run generate-vapid.
# The public key is embedded at build time; the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Required for scheduled reminders. Use a separate random secret.
CRON_SECRET=
REMINDER_TIMEZONE=Africa/Cairo
